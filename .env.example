# Application Configuration
NEXT_APP_NAME=Shadpanel Docs

# Better Auth (optional on this public demo)
# The demo falls back to an in-memory adapter and a hardcoded secret so
# Vercel Hobby can build and run without DATABASE_URL or BETTER_AUTH_SECRET.
# Set a real secret in production if you want sessions to survive secret rotation.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional — leave empty if unused)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional — leave empty if unused)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
